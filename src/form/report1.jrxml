		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="sks" class="java.lang.Integer">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="NTM" class="java.lang.String"/>
	<field name="bobot" class="java.lang.Integer">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="Mutu" class="java.lang.Long"/>
	<variable name="v_total_sks" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{sks}]]></variableExpression>
	</variable>
	<variable name="v_total_mutu" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{Mutu}]]></variableExpression>
	</variable>
	<variable name="v_ipk" class="java.lang.Double">
		<variableExpression><![CDATA[$V{v_total_sks} == 0 ? 0.0 : ($V{v_total_mutu} / (double)$V{v_total_sks})]]></variableExpression>
	</variable>
